<!--
	Bottom right, 64 wide (x 62..126) and up to ~31 tall with a full six-row board.
	One row per player, ordered by race progress (see hud_format.order_split_rows) -- a
	row moves only when its player is overtaken, so names stay readable mid-round.
	x=62 keeps the panel clear of the game's own checkpoint/time widget under the
	centre of the screen (its right edge sits near x=50) and of the stream lower
	third (which ends at x=60). The finish countdown shares this corner and is
	parked above y=-56 so the two never overlap -- move one, check the other.
-->
<frame pos="62. -56." z-index="50">
	<!-- header tab: black box + white bold label, matching the match panel -->
	<quad pos="0. 0." size="64. 5.4." halign="left" valign="top" z-index="-1" bgcolor="000000" opacity="0.85" />
	<label pos="2. -1.1." size="60. 3.4." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontBlack" textcolor="FFFFFF" text="SPLITS" />

	<!-- row backing so splits stay legible over bright track scenery -->
	<quad pos="0. -5.4." size="64. {{ body_height }}." halign="left" valign="top" z-index="-1" bgcolor="000000" opacity="0.75" />

	{% for row in rows %}
	<label pos="2. {{ row.y }}." size="34. 3.5." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="{{ row.name }}" />
	<label pos="40. {{ row.y }}." size="14. 3.5." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="AAAAAA" text="{{ row.cp_label }}" />
	<label pos="62. {{ row.y }}." size="18. 3.5." halign="right" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="{{ row.color }}" text="{{ row.split }}" />
	{% endfor %}
</frame>