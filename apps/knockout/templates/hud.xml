<frame pos="-159. 33." z-index="50">
	<!-- dark backing panel: sized in the view (bg_width/bg_height) so it always covers
	     the header + every player row, matching the BOTN countdown's black panels.
	     The frame sits at z-index=50 (like the countdown) so the whole composite lifts
	     above the 3D scene; the backing then renders at z-index=-1 -- below the labels
	     (z-index=1) but still above the scene. (A z-index=0 frame leaves the backing at
	     scene depth where it is clipped/occluded, which is why it was invisible.) -->
	<quad pos="0. 1." size="{{ bg_width }}. {{ bg_height }}." halign="left" valign="top" z-index="-1" bgcolor="000000" opacity="0.8" />

	<!-- title -->
	<label pos="{{ center_x }}. -1.3." size="50. 4." halign="center" valign="top" z-index="1"
		textsize="2" textfont="GameFontBlack" textcolor="FFFFFF" text="{{ match_text }}" />

	<!-- header stats -->
	<label pos="2. -7." size="34. 3." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="ROUND" />
	<label pos="{{ header_val_x }}. -7." size="20. 3." halign="right" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="{{ round_text }}" />

	<label pos="2. -11." size="34. 3." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="PLAYERS" />
	<label pos="{{ header_val_x }}. -11." size="20. 3." halign="right" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="{{ players_count }}" />

	<label pos="2. -15." size="28. 3." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="KOS PER ROUND" />
	<label pos="{{ header_val_x }}. -15." size="24. 3." halign="right" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="{{ ko_text }}" />

	{% if show_season %}
	<!-- cup-points column header -->
	<label pos="{{ pts_x }}. -18.2." size="12. 2.6." halign="right" valign="top" z-index="1"
		textsize="0" textfont="GameFontSemiBold" textcolor="FFCC00" text="CUP" />
	{% endif %}

	{% if has_divider %}
	<quad pos="2. {{ divider_y }}." size="{{ divider_w }}. 0.25." halign="left" valign="top" z-index="1" bgcolor="FFFFFF" opacity="0.5" />
	{% endif %}

	{% for row in rows %}
	{% if row.gap %}
	<label pos="{{ center_x }}. {{ row.y }}." size="50. 3.5." halign="center" valign="top" z-index="1"
		textsize="1" textcolor="AAAAAA" text="• • •" />
	{% else %}
	<label pos="2. {{ row.y }}." size="6. 3.5." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="{{ row.name_color }}" text="{{ row.rank }}" />
	<label pos="8. {{ row.y }}." size="32. 3.5." halign="left" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="{{ row.name_color }}" text="{{ row.name }}" />
	<label pos="{{ time_x }}. {{ row.y }}." size="18. 3.5." halign="right" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="{{ row.time_color }}" text="{{ row.time }}" />
	{% if show_season and row.season_points is not none %}
	<label pos="{{ pts_x }}. {{ row.y }}." size="12. 3.5." halign="right" valign="top" z-index="1"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFCC00" text="{{ row.season_points }}" />
	{% endif %}
	{% endif %}
	{% endfor %}
</frame>
