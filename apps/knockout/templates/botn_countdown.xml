<frame pos="114. 34." z-index="50">
	<!-- drop shadow -->
	<quad pos="0.8. -0.8." size="46. 27." halign="left" valign="top" bgcolor="000000" opacity="0.45" />

	<!-- body -->
	<quad pos="0. 0." size="46. 27." halign="left" valign="top" bgcolor="29313F" opacity="0.88" />
	<!-- thin outline -->
	<quad pos="0. 0." size="46. 27." halign="left" valign="top" style="Bgs1" substyle="BgColorContour" opacity="0.8" />

	<!-- header strip (BOTN blue) + accent underline -->
	<quad pos="0. 0." size="46. 6.2." halign="left" valign="top" bgcolor="0A84FF" opacity="0.95" />
	<quad pos="0. -6.2." size="46. 0.4." halign="left" valign="top" bgcolor="66B8FF" opacity="0.95" />
	<label pos="23. -1.5." size="44. 3.4." halign="center" valign="top"
		textsize="1" textfont="GameFontBlack" textcolor="FFFFFF" text="{{ header }}" />

	<!-- big readout (driven by the script) -->
	<label id="ko_botn_num" pos="23. -8.6." size="44. 12." halign="center" valign="top"
		textsize="6" textfont="GameFontBlack" textcolor="A6FFA6" text="15:00" />

	<!-- progress bar: track + depleting fill -->
	<quad pos="3. -23.2." size="40. 2.0." halign="left" valign="top" bgcolor="000000" opacity="0.6" />
	<quad id="ko_botn_bar" pos="3. -23.2." size="40. 2.0." halign="left" valign="top" bgcolor="66FF66" opacity="0.95" />
</frame>

<script><!--
#Include "TextLib" as TL

main() {
	declare CMlLabel CdNum <=> (Page.GetFirstChild("ko_botn_num") as CMlLabel);
	declare CMlQuad  CdBar <=> (Page.GetFirstChild("ko_botn_bar") as CMlQuad);
	declare Integer Total = {{ ms }};
	if (Total <= 0) Total = 1;
	declare Integer EndsAt = Now + Total;
	declare Real FullW = 40.0;
	while (True) {
		yield;
		declare Integer Left = EndsAt - Now;
		if (Left < 0) Left = 0;
		declare Integer Secs = (Left + 999) / 1000;
		// green for most of the wait, amber under 30s, red under 10s
		declare Vec3 Col = <0.65, 1.0, 0.65>;
		if (Secs <= 30) Col = <1.0, 0.85, 0.25>;
		if (Secs <= 10) Col = <1.0, 0.45, 0.45>;
		// H:MM:SS from an hour up, M:SS from a minute up, bare seconds below that
		declare Text T;
		if (Secs >= 3600) {
			declare Integer Hrs = Secs / 3600;
			declare Integer RemMin = (Secs % 3600) / 60;
			declare Integer RemSec = Secs % 60;
			declare Text MinPad = TL::ToText(RemMin);
			if (RemMin < 10) MinPad = "0" ^ MinPad;
			declare Text SecPad = TL::ToText(RemSec);
			if (RemSec < 10) SecPad = "0" ^ SecPad;
			T = TL::ToText(Hrs) ^ ":" ^ MinPad ^ ":" ^ SecPad;
		} else if (Secs >= 60) {
			declare Integer Mins = Secs / 60;
			declare Integer Rem = Secs % 60;
			declare Text RemPad = TL::ToText(Rem);
			if (Rem < 10) RemPad = "0" ^ RemPad;
			T = TL::ToText(Mins) ^ ":" ^ RemPad;
		} else {
			T = TL::ToText(Secs);
		}
		CdNum.SetText(T);
		CdNum.TextColor = Col;
		declare Real Ratio = Left * 1.0 / Total;
		CdBar.Size = <FullW * Ratio, 2.0>;
		CdBar.BgColor = Col;
	}
}
--></script>
