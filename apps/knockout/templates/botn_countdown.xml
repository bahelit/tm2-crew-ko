<frame pos="114. 34." z-index="50">
	<!-- header tab: black box + white bold label, matching the match panel -->
	<quad pos="0. 0." size="46. 7." halign="left" valign="top" z-index="-1" bgcolor="000000" opacity="0.85" />
	<label pos="23. -1.6." size="44. 4." halign="center" valign="top" z-index="1"
		textsize="2" textfont="GameFontBlack" textcolor="FFFFFF" text="{{ header }}" />

	<!-- dark backing so the readout stays legible over bright track scenery -->
	<quad pos="0. -7." size="46. 14." halign="left" valign="top" z-index="-1" bgcolor="000000" opacity="0.75" />
	<!-- big readout: white like the panel; the script shifts it amber/red near the end -->
	<label id="ko_botn_num" pos="23. -9.4." size="46. 12." halign="center" valign="top" z-index="1"
		textsize="6" textfont="GameFontBlack" textcolor="FFFFFF" text="15:00" />
</frame>

<script><!--
#Include "TextLib" as TL

main() {
	declare CMlLabel CdNum <=> (Page.GetFirstChild("ko_botn_num") as CMlLabel);
	declare Integer Total = {{ ms }};
	if (Total <= 0) Total = 1;
	declare Integer EndsAt = Now + Total;
	while (True) {
		yield;
		declare Integer Left = EndsAt - Now;
		if (Left < 0) Left = 0;
		declare Integer Secs = (Left + 999) / 1000;
		// white for most of the wait, amber under 30s, red under 10s
		declare Vec3 Col = <1.0, 1.0, 1.0>;
		if (Secs <= 30) Col = <1.0, 0.85, 0.25>;
		if (Secs <= 10) Col = <1.0, 0.45, 0.45>;
		// H:MM:SS from an hour up, M:SS from a minute up, bare seconds below that
		declare Text T;
		if (Secs >= 3600) {
			declare Integer Hrs = Secs / 3600;
			declare Integer RemMin = (Secs % 3600) / 60;
			declare Integer RemSec = Secs % 60;
			declare Text MinPad = TL::ToText(RemMin);
			if (RemMin < 10) MinPad = "0" ^ MinPad;
			declare Text SecPad = TL::ToText(RemSec);
			if (RemSec < 10) SecPad = "0" ^ SecPad;
			T = TL::ToText(Hrs) ^ ":" ^ MinPad ^ ":" ^ SecPad;
		} else if (Secs >= 60) {
			declare Integer Mins = Secs / 60;
			declare Integer Rem = Secs % 60;
			declare Text RemPad = TL::ToText(Rem);
			if (Rem < 10) RemPad = "0" ^ RemPad;
			T = TL::ToText(Mins) ^ ":" ^ RemPad;
		} else {
			T = TL::ToText(Secs);
		}
		CdNum.SetText(T);
		CdNum.TextColor = Col;
	}
}
--></script>
